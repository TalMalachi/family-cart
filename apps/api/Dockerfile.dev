# ─────────────────────────────────────────────────────────────────────────────
#  Development Dockerfile — uses tsx watch for hot reload
#  Source is mounted as a volume so changes reflect instantly
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app

RUN corepack enable && corepack prepare yarn@stable --activate

# Install dependencies
COPY package.json yarn.lock* ./
COPY apps/api/package.json        ./apps/api/package.json
COPY packages/shared/package.json ./packages/shared/package.json

RUN yarn install

# Copy source (will be overridden by volume mount in compose)
COPY packages/shared/ ./packages/shared/
COPY apps/api/        ./apps/api/
COPY scripts/         ./scripts/

WORKDIR /app/apps/api

EXPOSE 3000

# tsx watch restarts on any source change
CMD ["yarn", "dev"]
