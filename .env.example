# ── API ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://postgres:password@localhost:5434/familycart
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_32_char_random_string_minimum

CORS_ORIGIN=*

# ── Twilio (SMS) ────────────────────────────────────
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token
TWILIO_FROM=+1234567890

# ── Cloudflare R2 / AWS S3 (product images) ─────────
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=familycart-media
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_PUBLIC_URL=https://media.yourdomain.com

# ── Bootstrap default admin (first login) ─────────────
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_FULL_NAME=FamilyCart Admin
DEFAULT_ADMIN_PHONE=+10000000001
DEFAULT_ADMIN_EMAIL=admin@familycart.local
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_FAMILY_NAME=FamilyCart Home

# ── Mobile (Expo) ───────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
