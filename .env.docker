# ─────────────────────────────────────────────────────────────────────────────
#  FamilyCart — Docker environment defaults
#  Copy this to .env and fill in real values for Twilio / R2
#  The values below are safe defaults for local development only.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=familycart
POSTGRES_PASSWORD=familycart_dev
POSTGRES_DB=familycart

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_dev

# ── API ────────────────────────────────────────────────────────────────────────
# IMPORTANT: change this to a random 32+ char string in production
JWT_SECRET=dev_secret_change_me_for_production_min32

# ── Twilio SMS ─────────────────────────────────────────────────────────────────
# Leave empty → SMS codes print to docker logs instead of being sent
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ── Cloudflare R2 / AWS S3 ─────────────────────────────────────────────────────
# Leave empty → image uploads return a placeholder URL in dev
S3_ENDPOINT=
S3_BUCKET=familycart-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
